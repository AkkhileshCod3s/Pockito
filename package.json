{
  "name": "pockito",
  "productName": "Pockito",
  "version": "0.3.0",
  "description": "Pockito, a desktop pet companion that lives on your screen.",
  "author": "Akhilesh-Sappal <akhileshcodes.tech@gmail.com>",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/launch.mjs --dev",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "start": "npm run build && node scripts/launch.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "keywords": [
    "threejs",
    "electron",
    "desktop-pet",
    "pockito",
    "fish",
    "wolf",
    "guinea-pig"
  ],
  "build": {
    "appId": "com.pockito.app",
    "productName": "Pockito",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/tray*.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.4"
  }
}
